{
  "name": "nextmusic",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w @nextmusic/server & npm run dev -w @nextmusic/web",
    "build": "npm run build -w @nextmusic/web",
    "start": "npm run start -w @nextmusic/server",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.73.0"
  }
}
